{
  "template_id": "CVE-2026-118539",
  "template_path": "template.yaml",
  "compose_file": "lab/compose.yaml",
  "scanner_service": "scanner",
  "container_template": "/templates/template.yaml",
  "target_services": [
    "vulnerable",
    "patched",
    "legacy-vulnerable",
    "legacy-patched",
    "no-product",
    "later-product"
  ],
  "timeout_seconds": 180,
  "tests": [
    {
      "name": "affected_3x",
      "target": "http://vulnerable",
      "min_matches": 1,
      "max_matches": 1,
      "extra_args": [
        "-ni"
      ],
      "expected_product_gets": 1,
      "expected_cart_posts": 1,
      "expected_final_status": 200
    },
    {
      "name": "fixed_3x",
      "target": "http://patched",
      "min_matches": 0,
      "max_matches": 0,
      "extra_args": [
        "-ni"
      ],
      "expected_product_gets": 1,
      "expected_cart_posts": 1,
      "expected_final_status": 403
    },
    {
      "name": "affected_2x",
      "target": "http://legacy-vulnerable",
      "min_matches": 1,
      "max_matches": 1,
      "extra_args": [
        "-ni"
      ],
      "expected_product_gets": 1,
      "expected_cart_posts": 1,
      "expected_final_status": 200
    },
    {
      "name": "fixed_2x",
      "target": "http://legacy-patched",
      "min_matches": 0,
      "max_matches": 0,
      "extra_args": [
        "-ni"
      ],
      "expected_product_gets": 1,
      "expected_cart_posts": 1,
      "expected_final_status": 403
    },
    {
      "name": "no_public_product",
      "target": "http://no-product",
      "min_matches": 0,
      "max_matches": 0,
      "extra_args": [
        "-ni"
      ],
      "expected_product_gets": 63,
      "expected_cart_posts": 0,
      "expected_final_status": null
    },
    {
      "name": "later_product_13",
      "target": "http://later-product",
      "min_matches": 1,
      "max_matches": 1,
      "extra_args": [
        "-ni"
      ],
      "expected_product_gets": 11,
      "expected_cart_posts": 1,
      "expected_final_status": 200
    }
  ]
}
