{
  "template_id": "apache-roller-xmlrpc-extensions",
  "template_path": "template.yaml",
  "compose_file": "lab/compose.yaml",
  "scanner_service": "scanner",
  "container_template": "/templates/template.yaml",
  "target_services": ["affected", "vulnerable", "fixed"],
  "timeout_seconds": 900,
  "tests": [
    {"name": "roller-6-1-4", "target": "http://affected:8080", "min_matches": 1, "max_matches": 1},
    {"name": "roller-6-1-5", "target": "http://vulnerable:8080", "min_matches": 1, "max_matches": 1},
    {"name": "roller-6-1-6-default", "target": "http://fixed:8080", "min_matches": 0, "max_matches": 0},
    {"name": "roller-6-1-6-enabled", "target": "http://fixed:8080", "min_matches": 0, "max_matches": 0, "enable_xmlrpc": true}
  ]
}
