{
  "template_id": "elementor-rest-nonce-bypass",
  "template_path": "template.yaml",
  "compose_file": "lab/compose.yaml",
  "scanner_service": "scanner",
  "container_template": "/templates/template.yaml",
  "target_services": ["db", "vulnerable", "patched"],
  "setup_services": ["vulnerable", "patched"],
  "timeout_seconds": 240,
  "tests": [
    {"name":"vulnerable","target":"http://vulnerable","cookie_service":"vulnerable","min_matches":1,"max_matches":1},
    {"name":"patched","target":"http://patched","cookie_service":"patched","min_matches":0,"max_matches":0},
    {"name":"invalid-cookie","target":"http://vulnerable","cookie":"wordpress_logged_in_invalid=bad","min_matches":0,"max_matches":0}
  ]
}
